# --- Vision model (scanned invoice extraction) ---
# Provider is configurable: "ollama" (local, default/preferred) or "huggingface"
# (Hugging Face Inference Providers -- useful if local hardware can't run an 8B
# vision model at a reasonable speed; see README section 6 for why).
VISION_PROVIDER=ollama
QWEN_MODEL=qwen3-vl:8b
OLLAMA_BASE_URL=http://localhost:11434
# 120s is enough with a GPU or a lightly-loaded machine. On CPU-only hardware a single
# scanned-invoice request has been observed to take ~6 minutes -- raise this (e.g. 600) if so.
VISION_REQUEST_TIMEOUT_SECONDS=120

# --- Hugging Face Inference Providers (only used when VISION_PROVIDER=huggingface) ---
# Create a token with "Inference Providers" permission at https://huggingface.co/settings/tokens
# NEVER commit a real token -- this must stay blank in version control.
HF_API_TOKEN=
HF_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
HF_ROUTER_BASE_URL=https://router.huggingface.co/v1

# --- OCR ---
# Leave blank to use tesseract from PATH. On Windows, e.g.:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# --- Data sources ---
PO_FILE=data/purchase_orders.xlsx
VENDOR_FILE=data/vendors.xlsx
DATABASE_PATH=data/invoice_ledger.db

# --- Optional agentic exception-handling layer (never overrides decisions) ---
ENABLE_EXCEPTION_AGENT=false
EXCEPTION_AGENT_MODEL=qwen3-vl:8b

# --- PO matching ---
PO_MATCH_THRESHOLD=0.85
AMBIGUOUS_MATCH_MARGIN=0.05

# --- Extraction ---
MIN_TEXT_LENGTH_FOR_DIGITAL=40

# --- Financial rounding tolerance for arithmetic checks (currency units) ---
ARITHMETIC_TOLERANCE=1.0

# --- Temporary processing cache (NOT the permanent ledger) ---
TEMP_CACHE_TTL_HOURS=24

# --- API / CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=INFO
LOG_FILE=logs/app.log
